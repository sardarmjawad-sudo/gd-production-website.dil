  <div class="hero-glow hero-glow-2"></div>
  <div class="container hero-grid">
    <div class="hero-content anim-fade" data-anim="fade-right">
      <div class="badge"><span class="badge-dot"></span><span>Premium Agency Services in USA</span></div>
      <h1>Graphic Design, Websites &amp; <span class="text-gradient-gold">Local Marketing</span> for USA Businesses</h1>
      <p class="hero-sub">I help local businesses across the USA—from restaurants and salons to service providers and retail shops—grow with premium graphic design, web development, social media marketing, and Google Maps ranking.</p>
      <div class="hero-buttons">
        <a href="#contact" class="btn-primary">Get Free Consultation <span class="arrow">→</span></a>
        <a href="#portfolio" class="btn-outline">View My Work</a>
      </div>
      <div class="hero-stars">
        <div class="star-row">
          <div class="star-circle">★</div>
          <div class="star-circle">★</div>
          <div class="star-circle">★</div>
          <div class="star-circle">★</div>
          <div class="star-circle">★</div>
        </div>
        <p class="star-text">Trusted by <strong>50+</strong> Local USA Businesses</p>
      </div>
    </div>
    <div class="hero-visual anim-fade" data-anim="fade-up">
      <div class="mockup-wrapper">
        <div class="mockup-card mockup-website float-anim-1">
          <div class="browser-dots"><span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span></div>
          <div class="mockup-body"><div class="icon-monitor">🖥</div><p class="fw-600">Premium Website</p><p class="text-sm text-muted">Responsive Design</p></div>
        </div>
        <div class="mockup-card mockup-maps float-anim-2">
          <div class="maps-header"><div class="maps-icon">📍</div><div><div class="skeleton-bar"></div><div class="stars-text">★★★★★ <span class="text-muted text-xs">(128)</span></div></div></div>
          <div class="skeleton-lines"><div class="skeleton-bar full"></div><div class="skeleton-bar w80"></div><div class="skeleton-bar full"></div></div>
          <div class="maps-cta">Rank #1 on Google</div>
        </div>
        <div class="mockup-card mockup-social float-anim-3">
          <div class="social-header"><div class="social-avatar"></div><div class="skeleton-bar w60"></div></div>
          <div class="social-img">📱</div>
          <div class="skeleton-lines sm"><div class="skeleton-bar full"></div><div class="skeleton-bar w60"></div></div>
        </div>
      </div>
    </div>
