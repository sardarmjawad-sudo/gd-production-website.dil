<!-- ABOUT -->
<section class="section" id="about">
  <div class="container">
    <div class="about-grid">
      <div class="anim-fade" data-anim="fade-right">
        <h2>About <span class="text-gradient-gold">Muhammad Jawad Ahmad</span></h2>
        <div class="accent-line"></div>
        <div class="about-text">
          <p class="quote">"My disability is not my weakness — it is part of my strength, my discipline, and my motivation to work harder every day."</p>
          <p>My name is <strong>Muhammad Jawad Ahmad</strong>, and I am a professional graphic designer, web developer, social media marketing agent, and Google Maps ranking specialist.</p>
          <p>I am also a person with a disability, but I never allowed my challenges to stop me from building my skills, working hard, and helping businesses grow.</p>
          <p>I help local businesses in the USA look more professional and grow online through premium graphic design, modern websites, social media marketing, and Google Maps ranking.</p>
          <p>I have worked with a diverse range of local businesses—from restaurants and beauty salons to service dealerships and cafes.</p>
          <p>I believe in a <strong class="text-gold">work-first approach</strong>. No need to pay first — I show the quality of my work first, build trust, and then move forward.</p>
        </div>
      </div>
      <div class="about-image-wrapper anim-fade" data-anim="scale-in">
        <div class="about-glow"></div>
        <div class="about-frame">
          <div class="about-img-container">
            <img src="assets/jawad.png" alt="Muhammad Jawad Ahmad" class="about-photo">
            <div class="about-overlay"></div>
            <div class="about-label glass-morphism">
              <div class="label-icon"><div class="icon-inner">★</div></div>
              <div><p class="fw-900 text-white text-lg">Jawad Ahmad</p><p class="text-gold text-xs tracking-wide">PREMIUM DESIGNER</p></div>
            </div>
          </div>
        </div>
        <div class="floating-badge badge-clients float-anim-1"><p class="fw-700 text-lg">50+</p><p class="text-xs text-muted">Clients</p></div>
        <div class="floating-badge badge-satisfaction float-anim-2"><p class="fw-700 text-lg text-gold">100%</p><p class="text-xs text-muted">Satisfaction</p></div>
        <div class="floating-badge badge-strength float-anim-3">
          <div class="mini-icon">★</div>
          <div><p class="text-xs text-muted tracking-wide">DRIVEN BY</p><p class="text-xs fw-700 text-white">STRENGTH &amp; DISCIPLINE</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

